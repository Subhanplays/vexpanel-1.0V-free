generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPPORT
  NODE_MANAGER
  ADMIN
  SUPER_ADMIN
}
enum VpsStatus {
  PROVISIONING
  RUNNING
  STOPPED
  SUSPENDED
  ERROR
  DELETING
  DELETED
}
enum NodeStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  ERROR
}
enum IpStatus {
  AVAILABLE
  ASSIGNED
  RESERVED
  DISABLED
}
enum TaskStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}
enum BackupStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  DELETED
}
enum RdpProvider {
  DIRECT
  TAILSCALE
  PINGGY
}
enum TunnelStatus {
  DISABLED
  INSTALLING
  CONNECTED
  RECONNECTING
  OFFLINE
  ERROR
}

model User {
  id String @id @default(cuid())
  email String @unique
  username String @unique
  passwordHash String?
  discordId String? @unique
  role Role @default(USER)
  suspendedAt DateTime?
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  planId String?
  plan Plan? @relation(fields: [planId], references: [id])
  vpses Vps[]
  auditLogs AuditLog[]
  notifications Notification[]
  uiVersions UiVersion[]
}
model Node {
  id String @id @default(cuid())
  name String @unique
  address String
  status NodeStatus @default(OFFLINE)
  agentVersion String?
  lxdVersion String?
  cpuCores Int?
  ramMiB Int?
  diskGiB Int?
  tokenHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vpses Vps[]
  ips IpAddress[]
}
model OsImage {
  id String @id @default(cuid())
  name String @unique
  distribution String
  release String
  architecture String @default("amd64")
  imageAlias String @unique
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  vpses Vps[]
}
model Plan {
  id String @id @default(cuid())
  name String @unique
  cpu Int
  ramMiB Int
  diskGiB Int
  vpsLimit Int
  ipv4 Boolean @default(false)
  ipv6 Boolean @default(false)
  rdp Boolean @default(false)
  sshx Boolean @default(false)
  tailscale Boolean @default(false)
  backups Boolean @default(false)
  snapshots Boolean @default(false)
  users User[]
  vpses Vps[]
}
model Vps {
  id String @id @default(cuid())
  name String
  hostname String
  lxdName String @unique
  imageAlias String
  status VpsStatus @default(PROVISIONING)
  cpu Int
  ramMiB Int
  diskGiB Int
  ipv6 String?
  privateIp String?
  tailscaleIp String?
  createdAt DateTime @default(now())
  expiresAt DateTime?
  userId String
  nodeId String
  planId String?
  osImageId String?
  user User @relation(fields: [userId], references: [id])
  node Node @relation(fields: [nodeId], references: [id])
  plan Plan? @relation(fields: [planId], references: [id])
  osImage OsImage? @relation(fields: [osImageId], references: [id])
  ip IpAddress?
  rdp RdpAccess?
  tasks Task[]
  snapshots Snapshot[]
  backups Backup[]
  @@index([userId])
  @@index([nodeId])
}
model IpAddress {
  id String @id @default(cuid())
  address String @unique
  gateway String?
  cidr Int @default(32)
  status IpStatus @default(AVAILABLE)
  nodeId String
  vpsId String? @unique
  createdAt DateTime @default(now())
  node Node @relation(fields: [nodeId], references: [id])
  vps Vps? @relation(fields: [vpsId], references: [id])
}
model RdpAccess {
  id String @id @default(cuid())
  enabled Boolean @default(false)
  username String?
  provider RdpProvider?
  status TunnelStatus @default(DISABLED)
  host String?
  port Int @default(3389)
  passwordHash String?
  updatedAt DateTime @updatedAt
  vpsId String @unique
  vps Vps @relation(fields: [vpsId], references: [id])
}
model Task {
  id String @id @default(cuid())
  type String
  status TaskStatus @default(QUEUED)
  progress Int @default(0)
  payload Json
  result Json?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vpsId String?
  vps Vps? @relation(fields: [vpsId], references: [id])
}
model Snapshot {
  id String @id @default(cuid())
  name String
  sizeBytes BigInt?
  createdAt DateTime @default(now())
  vpsId String
  vps Vps @relation(fields: [vpsId], references: [id])
  @@unique([vpsId, name])
}
model Backup {
  id String @id @default(cuid())
  name String
  status BackupStatus @default(QUEUED)
  sizeBytes BigInt?
  storageRef String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  vpsId String
  vps Vps @relation(fields: [vpsId], references: [id])
}
model Notification {
  id String @id @default(cuid())
  type String
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id])
}
model Setting {
  key String @id
  value Json
  updatedAt DateTime @updatedAt
  updatedById String?
}
model UiVersion {
  id String @id @default(cuid())
  config Json
  active Boolean @default(false)
  createdAt DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id])
}
model AuditLog {
  id String @id @default(cuid())
  action String
  target String
  result String
  ip String?
  createdAt DateTime @default(now())
  actorId String?
  actor User? @relation(fields: [actorId], references: [id])
}
