{
  "name": "vexpanel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "start": "node dist/api/src/server.js",
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "worker": "tsx apps/api/src/worker.ts",
    "agent": "tsx apps/node-agent/src/agent.ts",
    "discord": "tsx apps/api/src/discord.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker\" \"npm run discord\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.1.1",
    "@prisma/client": "^6.5.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.40.6",
    "discord.js": "^14.27.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "jose": "^5.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
