NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://vexpanel:replace-me@localhost:5432/vexpanel
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://localhost:6379
PANEL_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
TRUST_PROXY=false

# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Tailscale (auth key for node containers)
TAILSCALE_AUTH_KEY=

# Pinggy (token for node containers)
PINGGY_TOKEN=

# Gemini AI (for Build Your Own UI)
GEMINI_API_KEY=

# Node Agent (used on each node)
VEXPANEL_API_URL=http://your-panel:3000
VEXPANEL_NODE_ID=
VEXPANEL_NODE_TOKEN=
VEXPANEL_BACKUP_DIR=/var/lib/vexpanel/backups
AGENT_POLL_SECONDS=5
